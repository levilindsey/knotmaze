+// K336: a confetti cannon, reusable (K318's themes aim cannons elsewhere).
+// Screen space, CSS px; angles in the screen's axes (+y down, so -PI/2
+// fires straight up).
+export interface CannonSpec {
+  x: number; // The launch point.
+  y: number;
+  angle: number; // The mean launch direction, radians.
+  speed: number; // The mean launch speed, px/s (aimCannon).
+  spread: number; // The cone's half-angle, radians.
+  paper: number; // Pieces of paper...
+  streamers: number; // ... and streamers it throws.
+  delay: number; // Seconds after the burst its first piece leaves.
+  volley: number; // Seconds its pieces leave over (front-loaded).
+}
+
+// The vertical launch speed whose arc rises `rise` px before it turns,
+// against linear drag `k` (1/s) with terminal fall `vt` px/s: the rise is
+// (v - vt ln(1 + v / vt)) / k, increasing in v, so bisect.
+function launchSpeedForRise(rise: number, k: number, vt: number): number {
+  const f = (v: number): number => (v - vt * Math.log(1 + v / vt)) / k;
+  let lo = 0;
+  let hi = Math.max(1, vt);
+  while (f(hi) < rise && hi < 1e7) hi *= 2;
+  for (let it = 0; it < 48; it++) {
+    const mid = 0.5 * (lo + hi);
+    if (f(mid) < rise) lo = mid;
+    else hi = mid;
+  }
+  return 0.5 * (lo + hi);
+}
+
+// The launch (angle, speed) that puts a cannon piece's arc top at (ax, ay)
+// from (x0, y0), on a screen `height` px tall (gravity follows it: the
+// terminal fall is CANNON_TERM heights/s) with CANNON_DRAG. With linear
+// drag the top comes when the vertical speed reaches 0, at a share
+// 1 - vt / (vt + v) of the horizontal reach vx / k.
+export function aimCannon(
+  x0: number,
+  y0: number,
+  ax: number,
+  ay: number,
+  height: number
+): { angle: number; speed: number } {
+  const k = CANNON_DRAG;
+  const vt = Math.max(1e-6, CANNON_TERM * height);
+  const rise = Math.max(0, y0 - ay);
+  const vy = launchSpeedForRise(rise, k, vt);
+  const share = vy / (vt + vy);
+  const vx = share > 1e-9 ? ((ax - x0) * k) / share : 0;
+  return { angle: Math.atan2(-vy, vx), speed: Math.sqrt(vx * vx + vy * vy) };
+}
