{
  // K393 groundwork (Option B), folded in by K1052: the test-inclusive
  // check. `npm run typecheck` runs it, so `npm test` and the deploy
  // type-check src and test together; the default tsconfig stays
  // src-only for editor speed. `npm run probe:types` still soft-counts
  // its errors without gating.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "vitest.config.ts", "vite.config.ts"]
}
